{
  "name": "tty-slides",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "build:landing": "node scripts/build-all.mjs --landing-only",
    "dev": "node scripts/dev.mjs",
    "dev:landing": "astro dev --root landing",
    "preview": "vite preview --config scripts/preview.config.mjs",
    "export": "slidev export"
  },
  "dependencies": {
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "latest",
    "@slidev/theme-seriph": "latest",
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "astro": "^7.4.2",
    "vite": "^8.3.5",
    "wrangler": "^4.153.0",
    "yaml": "^2.8.3"
  }
}
