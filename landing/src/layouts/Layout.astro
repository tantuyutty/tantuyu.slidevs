---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      content="#f7f7f7"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#141414"
      media="(prefers-color-scheme: dark)"
    />

    <script is:inline>
      const root = document.documentElement;
      root.classList.add("js");
      let preference = null;
      try {
        const stored = localStorage.getItem("theme");
        if (stored === "light" || stored === "dark") preference = stored;
      } catch {}
      const systemDark =
        typeof matchMedia === "function" &&
        matchMedia("(prefers-color-scheme: dark)").matches;
      const theme = preference ?? (systemDark ? "dark" : "light");
      root.dataset.theme = theme;
      for (const meta of document.querySelectorAll(
        'meta[name="theme-color"]',
      )) {
        meta.setAttribute("content", theme === "dark" ? "#141414" : "#f7f7f7");
      }
    </script>
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://slides.tantuyu.dev" />

    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content="tantuyu.slidevs" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --background: #f7f7f7;
    --surface: #ffffff;
    --surface-active: #ededed;
    --border: #d6d6d6;
    --border-strong: #b5b5b5;
    --text: #202020;
    --muted: #606060;
    --faint: #696969;
    --accent: #79501e;
    --accent-soft: #e9dfd1;
    font-family:
      Geist,
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    font-synthesis: none;
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
    --background: #141414;
    --surface: #191919;
    --surface-active: #212121;
    --border: #292929;
    --border-strong: #333333;
    --text: #edf2f4;
    --muted: #8b8b8b;
    --faint: #8b8b8b;
    --accent: #d0ae7d;
    --accent-soft: #16383e;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) {
      color-scheme: dark;
      --background: #141414;
      --surface: #191919;
      --surface-active: #212121;
      --border: #292929;
      --border-strong: #333333;
      --text: #edf2f4;
      --muted: #8b8b8b;
      --faint: #8b8b8b;
      --accent: #d0ae7d;
      --accent-soft: #16383e;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-width: 20rem;
    background: var(--background);
  }

  body {
    min-height: 100vh;
    margin: 0;
    color: var(--text);
    background: var(--background);
    background-size: 3rem 3rem;
    background-position: -1px -1px;
    background-attachment: fixed;
    -webkit-font-smoothing: antialiased;
  }

  body::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    content: "";
    background: radial-gradient(
      circle at 50% 0%,
      rgb(9 11 13 / 0%) 0%,
      var(--background) 42rem
    );
  }

  a {
    color: inherit;
  }

  button,
  input {
    font: inherit;
  }

  ::selection {
    color: var(--background);
    background: var(--accent);
  }
</style>
