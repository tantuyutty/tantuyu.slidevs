<div class="search">
  <label for="slide-search">搜尋簡報</label>
  <div class="search__field">
    <span aria-hidden="true">/</span>
    <input
      id="slide-search"
      type="search"
      placeholder="輸入簡報名稱"
      autocomplete="off"
      data-slide-search
    />
  </div>
</div>

<p class="no-results" data-no-results aria-live="polite" hidden>找不到符合的簡報。</p>

<script>
  const input = document.querySelector<HTMLInputElement>("[data-slide-search]");
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-slide-card]"));
  const noResults = document.querySelector<HTMLElement>("[data-no-results]");

  function filterSlides(query: string) {
    const normalizedQuery = query.trim().toLocaleLowerCase("zh-Hant");
    let visibleCount = 0;

    for (const card of cards) {
      const matches = (card.dataset.searchTitle ?? "").includes(normalizedQuery);
      card.hidden = !matches;
      if (matches) visibleCount += 1;
    }

    if (noResults) noResults.hidden = visibleCount > 0;
  }

  input?.addEventListener("input", () => filterSlides(input.value));
</script>

<style>
  .search {
    margin-bottom: 1.5rem;
  }

  label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .search__field {
    display: flex;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    transition: border-color 140ms ease;
  }

  .search__field:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent-soft);
  }

  .search__field span {
    padding-left: 1rem;
    color: var(--accent);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
  }

  input {
    width: 100%;
    padding: 0.875rem 1rem 0.875rem 0.625rem;
    color: var(--text);
    background: transparent;
    border: 0;
    outline: 0;
  }

  input::placeholder {
    color: var(--faint);
  }

  input::-webkit-search-cancel-button {
    /* Keep the native glyph light-scheme before the explicit dark inversion. */
    color-scheme: light;
    opacity: 1;
  }

  :global([data-theme="dark"]) input::-webkit-search-cancel-button {
    filter: invert(1);
  }

  .no-results {
    padding: 3rem 1rem;
    margin: 0;
    color: var(--muted);
    text-align: center;
    border: 1px dashed var(--border);
  }

  @media (prefers-reduced-motion: reduce) {
    .search__field {
      transition: none;
    }
  }
</style>
