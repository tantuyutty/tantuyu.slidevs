<div class="view-toggle" role="group" aria-label="簡報顯示方式" hidden>
  <button
    type="button"
    data-slide-view="card"
    aria-pressed="true"
    aria-controls="slide-grid"
  >
    <svg
      aria-hidden="true"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <rect x="3" y="3" width="7" height="7" rx="1"></rect>
      <rect x="14" y="3" width="7" height="7" rx="1"></rect>
      <rect x="3" y="14" width="7" height="7" rx="1"></rect>
      <rect x="14" y="14" width="7" height="7" rx="1"></rect>
    </svg>
    卡片
  </button>
  <button
    type="button"
    data-slide-view="list"
    aria-pressed="false"
    aria-controls="slide-grid"
  >
    <svg
      aria-hidden="true"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
    >
      <path d="M8 5h13M8 12h13M8 19h13M3 5h.01M3 12h.01M3 19h.01"></path>
    </svg>
    列表
  </button>
</div>

<script>
  const toggle = document.querySelector<HTMLElement>(".view-toggle");
  const grid = document.querySelector<HTMLElement>("[data-slide-grid]");
  const buttons = Array.from(
    toggle?.querySelectorAll<HTMLButtonElement>("[data-slide-view]") ?? [],
  );

  if (toggle && grid) {
    toggle.hidden = false;
    for (const button of buttons) {
      button.addEventListener("click", () => {
        grid.dataset.view = button.dataset.slideView;
        for (const option of buttons) {
          option.setAttribute("aria-pressed", String(option === button));
        }
      });
    }
  }
</script>

<style>
  .view-toggle {
    display: inline-flex;
    flex: 0 0 auto;
    margin-left: auto;
    padding: 0.125rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.25rem;
  }

  .view-toggle[hidden] {
    display: none;
  }

  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    color: var(--muted);
    background: transparent;
    border: 0;
    border-radius: 0.125rem;
    font-size: 0.8125rem;
    cursor: pointer;
  }

  button:hover {
    color: var(--text);
    background: var(--surface-active);
  }

  button[aria-pressed="true"] {
    color: var(--accent);
    background: var(--surface-active);
    font-weight: bold;
  }

  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  svg {
    flex: none;
  }
</style>
