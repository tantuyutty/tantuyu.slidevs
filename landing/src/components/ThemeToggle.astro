<button class="theme-toggle" type="button" aria-label="切換至深色模式" data-theme-toggle>
  <svg class="theme-toggle__moon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z" />
  </svg>
  <svg class="theme-toggle__sun" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4m0-14.2-1.4 1.4M6.3 17.7l-1.4 1.4" />
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const root = document.documentElement;
  const systemTheme =
    typeof matchMedia === "function"
      ? matchMedia("(prefers-color-scheme: dark)")
      : null;
  let preference: "light" | "dark" | null = null;
  try {
    const stored = localStorage.getItem("theme");
    if (stored === "light" || stored === "dark") preference = stored;
  } catch {}

  function applyTheme(theme: "light" | "dark") {
    root.dataset.theme = theme;
    const label = theme === "dark" ? "切換至淺色模式" : "切換至深色模式";
    button?.setAttribute("aria-label", label);
    button?.setAttribute("title", label);
    for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
      meta.setAttribute("content", theme === "dark" ? "#141414" : "#f7f7f7");
    }
  }

  applyTheme(preference ?? (systemTheme?.matches ? "dark" : "light"));

  button?.addEventListener("click", () => {
    preference = root.dataset.theme === "dark" ? "light" : "dark";
    applyTheme(preference);
    try {
      localStorage.setItem("theme", preference);
    } catch {}
  });

  systemTheme?.addEventListener("change", (event) => {
    if (preference === null) applyTheme(event.matches ? "dark" : "light");
  });
</script>

<style>
  .theme-toggle {
    display: none;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    color: var(--accent);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    cursor: pointer;
  }

  :global(.js) .theme-toggle {
    display: inline-flex;
  }

  .theme-toggle:hover {
    background: var(--surface-active);
    border-color: var(--border-strong);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .theme-toggle__sun,
  :global([data-theme="dark"]) .theme-toggle__moon {
    display: none;
  }

  :global([data-theme="dark"]) .theme-toggle__sun {
    display: block;
  }
</style>
