---
import type { ComponentProps } from "astro/types";
import Footer from "../components/Footer.astro";
import SlideCard from "../components/SlideCard.astro";
import SlideSearch from "../components/SlideSearch.astro";
import SlideViewToggle from "../components/SlideViewToggle.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Layout from "../layouts/Layout.astro";
import { discoverSlidesWithMetadata } from "../../../scripts/slides.mjs";

type Slide = Required<ComponentProps<typeof SlideCard>>;

const slides: Slide[] = discoverSlidesWithMetadata()
  .map(({ slug, meta }): Slide => {
    const title = typeof meta.title === "string" ? meta.title : slug;
    const rawDescription = meta.description ?? meta.info ?? "";
    const description =
      typeof rawDescription === "string"
        ? rawDescription.replace(/[#*_`\[\]()]/g, "").trim()
        : "";
    const date = typeof meta.date === "string" ? meta.date : "";

    return { slug, title, description, date };
  })
  .sort((a, b) => {
    if (a.date && b.date) return b.date.localeCompare(a.date);
    if (a.date) return -1;
    if (b.date) return 1;
    return a.title.localeCompare(b.title, "zh-Hant");
  });
---

<Layout title="tantuyu.slidevs" description="tantuyu 的簡報">
  <main class="shell">
    <header>
      <div class="header-top">
        <p class="path" aria-label="tantuyu.slidevs">~/tantuyu.slidevs</p>
        <ThemeToggle />
      </div>
      <h1>tantuyu.<wbr />slidevs</h1>
      <p class="intro">放養可愛的簡報們</p>
    </header>

    <section aria-labelledby="slide-list-title">
      <div class="section-heading">
        <h2 id="slide-list-title">簡報列表</h2>
        <span data-slide-count aria-live="polite">{slides.length} slides</span>
        <SlideViewToggle />
      </div>

      <SlideSearch />

      <div class="slide-grid" id="slide-grid" data-slide-grid data-view="card">
        {slides.map((slide) => <SlideCard {...slide} />)}
      </div>
    </section>

    <Footer />
  </main>
</Layout>

<script>
  const shell = document.querySelector<HTMLElement>(".shell");

  if (shell) {
    const targets = Array.from(
      shell.querySelectorAll<HTMLElement>(
        ".header-top, header > h1, .intro, .section-heading, .search, [data-slide-card], footer",
      ),
    );

    function finishEntrance(element: HTMLElement): void {
      element.style.animation = "none";
    }

    shell.addEventListener("animationend", (event) => {
      if (
        event.target instanceof HTMLElement &&
        targets.includes(event.target) &&
        event.pseudoElement === ""
      ) {
        finishEntrance(event.target);
      }
    });

    for (const element of targets) {
      const isAnimating = element
        .getAnimations()
        .some(
          (animation) => animation.playState === "running" || animation.pending,
        );
      if (!isAnimating) finishEntrance(element);
    }

    // Finish before the search listener toggles display and can restart animations.
    shell.addEventListener(
      "input",
      (event) => {
        if (
          event.target instanceof HTMLElement &&
          event.target.matches("[data-slide-search]")
        ) {
          for (const element of targets) {
            if (element.matches("[data-slide-card]")) finishEntrance(element);
          }
        }
      },
      { capture: true },
    );

    shell.addEventListener("focusin", (event) => {
      if (event.target instanceof Node) {
        for (const element of targets) {
          if (element.contains(event.target)) finishEntrance(element);
        }
      }
    });
  }
</script>

<style>
  .shell {
    --entrance-step: 40ms;
    width: min(100% - 2.5rem, 52rem);
    margin-inline: auto;
    padding-block: clamp(3.5rem, 9vw, 7rem) 2.5rem;
  }

  header {
    margin-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  .header-top {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .path {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
    color: var(--accent);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.8125rem;
  }

  h1 {
    font-family: "Lora", "Noto Serif TC", serif;
    max-width: 12ch;
    margin: 0;
    font-size: clamp(2.75rem, 9vw, 5.5rem);
    font-weight: 700;
    font-optical-sizing: auto;
    line-height: 0.95;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .intro {
    font-family: "Lora", "Noto Serif TC", serif;
    margin: 1.5rem 0 0;
    color: var(--muted);
    font-size: 1.0625rem;
  }

  .section-heading {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .section-heading h2 {
    font-family: "Lora", "Noto Serif TC", serif;
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .section-heading span {
    color: var(--faint);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.75rem;
  }

  .slide-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .slide-grid[data-view="list"] {
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--border);
  }

  @keyframes landing-enter {
    from {
      opacity: 0;
      transform: translateY(6px);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  .shell
    :global(
      :where(
        .header-top,
        header > h1,
        .intro,
        .section-heading,
        .search,
        [data-slide-card],
        footer
      )
    ) {
    animation: landing-enter 200ms ease-out
      calc(var(--entrance-step) * var(--entrance-stage, 0)) 1 backwards;
  }

  .shell :global(header > h1) {
    --entrance-stage: 1;
  }

  .shell :global(.intro) {
    --entrance-stage: 2;
  }

  .shell :global(.section-heading) {
    --entrance-stage: 3;
  }

  .shell :global(.search) {
    --entrance-stage: 4;
  }

  .shell :global([data-slide-card]) {
    --entrance-stage: 10;
  }

  .shell :global(.slide-grid > [data-slide-card]:nth-child(1)) {
    --entrance-stage: 5;
  }

  .shell :global(.slide-grid > [data-slide-card]:nth-child(2)) {
    --entrance-stage: 6;
  }

  .shell :global(.slide-grid > [data-slide-card]:nth-child(3)) {
    --entrance-stage: 7;
  }

  .shell :global(.slide-grid > [data-slide-card]:nth-child(4)) {
    --entrance-stage: 8;
  }

  .shell :global(.slide-grid > [data-slide-card]:nth-child(5)) {
    --entrance-stage: 9;
  }

  .shell :global(footer) {
    --entrance-stage: 11;
  }

  @media (prefers-reduced-motion: reduce) {
    .shell
      :global(
        :where(
          .header-top,
          header > h1,
          .intro,
          .section-heading,
          .search,
          [data-slide-card],
          footer
        )
      ) {
      animation: none;
    }
  }

  @media (max-width: 40rem) {
    .slide-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
